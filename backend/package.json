{
  "name": "sprintfour-backend",
  "version": "2.0.0",
  "private": true,
  "description": "API and ingestion pipeline for the SprintFour PII triage tool",
  "main": "server.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/*.test.js",
